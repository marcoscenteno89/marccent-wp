{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": { "contentSize": "var(--wrap-max)", "wideSize": "var(--wrap-lg)" },
		"color": {
			"defaultPalette": false,
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "var(--primary)" },
				{ "slug": "secondary", "name": "Secondary", "color": "var(--secondary)" },
				{ "slug": "body", "name": "Text", "color": "var(--body-color)" },
				{ "slug": "muted", "name": "Muted", "color": "var(--muted-color)" },
				{ "slug": "surface", "name": "Surface", "color": "var(--surface)" },
				{ "slug": "dark", "name": "Dark", "color": "var(--dark)" },
				{ "slug": "light", "name": "Light", "color": "var(--light)" }
			],
			"gradients": [ { "slug": "brand", "name": "Brand", "gradient": "var(--gradient)" } ]
		},
		"typography": { "defaultFontSizes": false, "fontSizes": [], "fluid": false, "customFontSize": false, "lineHeight": false, "fontFamilies": [] },
		"spacing": {
			"defaultSpacingSizes": false,
			"customSpacingSize": false,
			"spacingSizes": [
				{ "slug": "xs", "name": "Extra small", "size": "var(--space-xs)" },
				{ "slug": "sm", "name": "Small", "size": "var(--space-sm)" },
				{ "slug": "base", "name": "Normal", "size": "var(--space)" },
				{ "slug": "md", "name": "Medium", "size": "var(--space-md)" },
				{ "slug": "lg", "name": "Large", "size": "var(--space-lg)" },
				{ "slug": "xl", "name": "Extra large", "size": "var(--space-xl)" },
				{ "slug": "2xl", "name": "Double", "size": "var(--space-2xl)" },
				{ "slug": "section", "name": "Section", "size": "var(--section-space)" }
			]
		}
	},
	"styles": {
		"spacing": { "blockGap": "0px", "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" } }
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
